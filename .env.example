LITEDVR_RETENTION_DAYS=30
LITEDVR_DEFAULT_SEGMENT_MINUTES=60
LITEDVR_ALLOWED_ORIGINS=http://localhost:8081
LITEDVR_MOCK_MODE=false
# Deployment options. linux/386 is intended for a 32-bit Debian Docker host.
LITEDVR_PLATFORM=linux/386
LITEDVR_DATA_DIR=./.local-data
LITEDVR_IMAGE=litedvr:local
LITEDVR_FRONTEND_IMAGE=litedvr-frontend:local
